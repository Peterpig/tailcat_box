{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tailcat Box",
  "version": "0.1.0",
  "identifier": "dev.tailcat.box",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tailcat Box",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../THIRD_PARTY_NOTICES.md", "../LICENSE"],
    "category": "DeveloperTool",
    "shortDescription": "Tailcat 图形客户端",
    "longDescription": "Tailcat Box 是 tailcat 官方 CLI 的跨平台图形客户端：监听服务、端口转发、文件传输与目录共享，全部基于官方 CLI，不修改系统路由，不需要账号登录。",
    "copyright": "Copyright (c) 2026 Tailcat Box contributors",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
